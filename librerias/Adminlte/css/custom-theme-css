:root {
    --primary-red: #B0291C;
    --primary-gold: #CC8E00;
    --primary-green: #0ce98b8c;
    --background-bk-green: radial-gradient(circle at 100% 70.9666633605957%, rgba(12, 233, 139, 0.55) 0%, 10.5%, rgba(12, 233, 139, 0) 35%), radial-gradient(circle at 52.266674041748054% 38.43336423238119%, rgba(0, 0, 0, 0.99) 0%, 25%, rgba(0, 0, 0, 0) 50%), radial-gradient(circle at 0% 66.70000076293945%, rgba(12, 233, 139, 0.55) 0%, 11.4%, rgba(12, 233, 139, 0) 38%), radial-gradient(circle at 48.9013671875% 49.521484375%, #000000 0%, 100%, rgba(0, 0, 0, 0) 100%);
    --white: #ffffff;
    --black: #000000;
    --glass-bg: rgba(255, 255, 255, 0.08);
    --glass-border: rgba(255, 255, 255, 0.15);
    --text-primary: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.8);
    --text-muted: rgba(255, 255, 255, 0.6);
    --input-bg: rgba(0, 0, 0, 0.2);
    --input-border: rgba(255, 255, 255, 0.2);
    --shadow-glow: 0 0 40px rgba(12, 233, 139, 0.15);
}

/* Base Styles */
* {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
}

body {
    background: var(--background-bk-green) !important;
    min-height: 100vh;
    position: relative;
}

/* Background decorative elements */
body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        radial-gradient(circle at 85% 20%, rgba(204, 142, 0, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 15% 80%, rgba(12, 233, 139, 0.1) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}

.wrapper, .content-wrapper, .main-sidebar, .main-header {
    position: relative;
    z-index: 1;
}

/* Sidebar Styles */
.main-sidebar {
    background: var(--glass-bg) !important;
    backdrop-filter: blur(20px);
    border-right: 2px solid var(--glass-border) !important;
    box-shadow: var(--shadow-glow), 4px 0 20px rgba(0, 0, 0, 0.3);
}

.sidebar {
    background: transparent !important;
}

/* Brand Logo */
.brand-link {
    background: rgba(255, 255, 255, 0.1) !important;
    border-bottom: 1px solid var(--glass-border) !important;
    backdrop-filter: blur(10px);
}

.brand-link .brand-text {
    color: var(--text-primary) !important;
    font-weight: 700 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

/* Navigation Menu */
.nav-sidebar .nav-item > .nav-link {
    color: var(--text-secondary) !important;
    border-radius: 12px !important;
    margin: 0.25rem 0.5rem !important;
    padding: 0.75rem 1rem !important;
    transition: all 0.3s ease !important;
    backdrop-filter: blur(10px);
}

.nav-sidebar .nav-item > .nav-link:hover,
.nav-sidebar .nav-item > .nav-link.active {
    background: linear-gradient(135deg, rgba(12, 233, 139, 0.2) 0%, rgba(12, 233, 139, 0.1) 100%) !important;
    color: var(--text-primary) !important;
    box-shadow: 0 4px 12px rgba(12, 233, 139, 0.2) !important;
    border: 1px solid rgba(12, 233, 139, 0.3) !important;
}

.nav-sidebar .nav-item > .nav-link i {
    color: var(--primary-green) !important;
    margin-right: 0.75rem !important;
}

/* Header Styles */
.main-header {
    background: var(--glass-bg) !important;
    backdrop-filter: blur(20px);
    border-bottom: 2px solid var(--glass-border) !important;
    box-shadow: var(--shadow-glow), 0 4px 20px rgba(0, 0, 0, 0.3);
}

.navbar-light .navbar-nav .nav-link {
    color: var(--text-primary) !important;
    transition: all 0.3s ease;
}

.navbar-light .navbar-nav .nav-link:hover {
    color: var(--primary-green) !important;
}

/* Content Wrapper */
.content-wrapper {
    background: transparent !important;
    margin-left: 250px;
    padding: 1rem;
}

/* Content Header */
.content-header {
    background: var(--glass-bg) !important;
    backdrop-filter: blur(20px);
    border: 2px solid var(--glass-border) !important;
    border-radius: 16px !important;
    margin-bottom: 1rem !important;
    padding: 1.5rem !important;
    box-shadow: var(--shadow-glow), 0 8px 32px rgba(0, 0, 0, 0.3);
}

.content-header h1 {
    color: var(--text-primary) !important;
    font-weight: 700 !important;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

.breadcrumb {
    background: transparent !important;
    margin: 0 !important;
}

.breadcrumb-item {
    color: var(--text-secondary) !important;
}

.breadcrumb-item.active {
    color: var(--primary-green) !important;
}

.breadcrumb-item + .breadcrumb-item::before {
    color: var(--text-muted) !important;
}

/* Cards */
.card {
    background: var(--glass-bg) !important;
    backdrop-filter: blur(20px) !important;
    border: 2px solid var(--glass-border) !important;
    border-radius: 16px !important;
    box-shadow: var(--shadow-glow), 0 8px 32px rgba(0, 0, 0, 0.3) !important;
    margin-bottom: 1.5rem;
}

.card-header {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%) !important;
    border-bottom: 1px solid var(--glass-border) !important;
    border-radius: 14px 14px 0 0 !important;
}

.card-title {
    color: var(--text-primary) !important;
    font-weight: 600 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.card-body {
    color: var(--text-secondary) !important;
}

/* Forms */
.form-control {
    background: var(--input-bg) !important;
    backdrop-filter: blur(10px) !important;
    border: 2px solid var(--input-border) !important;
    border-radius: 12px !important;
    color: var(--text-primary) !important;
    transition: all 0.3s ease !important;
}

.form-control:focus {
    background: rgba(0, 0, 0, 0.3) !important;
    border-color: var(--primary-green) !important;
    box-shadow: 0 0 0 3px rgba(12, 233, 139, 0.15), 0 0 20px rgba(12, 233, 139, 0.2) !important;
    color: var(--text-primary) !important;
}

.form-control::placeholder {
    color: var(--text-muted) !important;
}

.form-label, label {
    color: var(--text-primary) !important;
    font-weight: 500 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

/* Buttons */
.btn-primary {
    background: linear-gradient(135deg, var(--primary-red) 0%, #8B1E14 100%) !important;
    border: none !important;
    border-radius: 12px !important;
    font-weight: 600 !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 12px rgba(176, 41, 28, 0.3) !important;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #8B1E14 0%, var(--primary-red) 100%) !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 20px rgba(176, 41, 28, 0.4) !important;
}

.btn-success {
    background: linear-gradient(135deg, rgba(12, 233, 139, 0.8) 0%, rgba(12, 233, 139, 0.6) 100%) !important;
    border: none !important;
    border-radius: 12px !important;
    font-weight: 600 !important;
    color: var(--black) !important;
}

.btn-warning {
    background: linear-gradient(135deg, var(--primary-gold) 0%, #B8780A 100%) !important;
    border: none !important;
    border-radius: 12px !important;
    font-weight: 600 !important;
}

/* Tables */
.table {
    color: var(--text-secondary) !important;
}

.table thead th {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.1) 100%) !important;
    color: var(--text-primary) !important;
    border: none !important;
    font-weight: 600 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.table tbody tr {
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
}

.table tbody tr:hover {
    background: rgba(12, 233, 139, 0.1) !important;
}

.table td {
    border-color: var(--glass-border) !important;
}

/* Modals */
.modal-content {
    background: var(--glass-bg) !important;
    backdrop-filter: blur(20px) !important;
    border: 2px solid var(--glass-border) !important;
    border-radius: 16px !important;
    box-shadow: var(--shadow-glow), 0 25px 50px rgba(0, 0, 0, 0.5) !important;
}

.modal-header {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%) !important;
    border-bottom: 1px solid var(--glass-border) !important;
    border-radius: 14px 14px 0 0 !important;
}

.modal-title {
    color: var(--text-primary) !important;
    font-weight: 600 !important;
}

.modal-body {
    color: var(--text-secondary) !important;
}

/* Alerts */
.alert-success {
    background: linear-gradient(135deg, rgba(12, 233, 139, 0.2) 0%, rgba(12, 233, 139, 0.1) 100%) !important;
    border: 1px solid rgba(12, 233, 139, 0.4) !important;
    color: var(--primary-green) !important;
    backdrop-filter: blur(10px) !important;
    border-radius: 12px !important;
}

.alert-danger {
    background: linear-gradient(135deg, rgba(176, 41, 28, 0.2) 0%, rgba(176, 41, 28, 0.1) 100%) !important;
    border: 1px solid rgba(176, 41, 28, 0.4) !important;
    color: #ff6b6b !important;
    backdrop-filter: blur(10px) !important;
    border-radius: 12px !important;
}

.alert-warning {
    background: linear-gradient(135deg, rgba(204, 142, 0, 0.2) 0%, rgba(204, 142, 0, 0.1) 100%) !important;
    border: 1px solid rgba(204, 142, 0, 0.4) !important;
    color: var(--primary-gold) !important;
    backdrop-filter: blur(10px) !important;
    border-radius: 12px !important;
}

/* Info Box */
.info-box {
    background: var(--glass-bg) !important;
    backdrop-filter: blur(20px) !important;
    border: 2px solid var(--glass-border) !important;
    border-radius: 16px !important;
    box-shadow: var(--shadow-glow), 0 8px 32px rgba(0, 0, 0, 0.3) !important;
}

.info-box-icon {
    border-radius: 14px 0 0 14px !important;
}

.info-box-text, .info-box-number {
    color: var(--text-primary) !important;
    font-weight: 600 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

/* Small Box */
.small-box {
    border-radius: 16px !important;
    backdrop-filter: blur(20px) !important;
    border: 2px solid var(--glass-border) !important;
    box-shadow: var(--shadow-glow), 0 8px 32px rgba(0, 0, 0, 0.3) !important;
    overflow: hidden;
    position: relative;
}

.small-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--primary-green), var(--primary-gold));
}

.small-box h3, .small-box p {
    color: var(--text-primary) !important;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5) !important;
}

.small-box .small-box-footer {
    background: rgba(0, 0, 0, 0.2) !important;
    color: var(--text-secondary) !important;
}

/* Dropdown */
.dropdown-menu {
    background: var(--glass-bg) !important;
    backdrop-filter: blur(20px) !important;
    border: 2px solid var(--glass-border) !important;
    border-radius: 12px !important;
    box-shadow: var(--shadow-glow), 0 8px 32px rgba(0, 0, 0, 0.3) !important;
}

.dropdown-item {
    color: var(--text-secondary) !important;
    transition: all 0.3s ease !important;
}

.dropdown-item:hover {
    background: rgba(12, 233, 139, 0.2) !important;
    color: var(--text-primary) !important;
}

/* Pagination */
.page-item .page-link {
    background: var(--glass-bg) !important;
    border: 1px solid var(--glass-border) !important;
    color: var(--text-secondary) !important;
    backdrop-filter: blur(10px) !important;
}

.page-item.active .page-link {
    background: linear-gradient(135deg, var(--primary-green) 0%, rgba(12, 233, 139, 0.8) 100%) !important;
    border-color: var(--primary-green) !important;
    color: var(--black) !important;
}

/* Footer */
.main-footer {
    background: var(--glass-bg) !important;
    backdrop-filter: blur(20px) !important;
    border-top: 2px solid var(--glass-border) !important;
    color: var(--text-secondary) !important;
    margin-left: 250px !important;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .content-wrapper,
    .main-footer {
        margin-left: 0 !important;
    }
    
    .main-sidebar {
        transform: translateX(-250px);
        transition: transform 0.3s ease;
    }
    
    .main-sidebar.open {
        transform: translateX(0);
    }
}

/* Loading animations */
@keyframes pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
}

.loading-pulse {
    animation: pulse 2s infinite;
}

/* Custom scrollbar */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.1);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--primary-green), var(--primary-gold));
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, var(--primary-gold), var(--primary-green));
}